{
    "$schema": "https://captainhookphp.github.io/captainhook/schema.json",
    "commit-msg": {
        "enabled": false,
        "actions": []
    },
    "pre-push": {
        "enabled": false,
        "actions": []
    },
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "\\FernleafSystems\\QA\\CaptainHook\\PreCommitAction",
                "options": {
                    "label": "FernleafSystems QA Checks"
                }
            }
        ]
    },
    "post-merge": {
        "enabled": false,
        "actions": []
    },
    "post-checkout": {
        "enabled": false,
        "actions": []
    },
    "post-rewrite": {
        "enabled": false,
        "actions": []
    },
    "post-change": {
        "enabled": true,
        "actions": [
            {
                "action": "composer install --no-interaction",
                "options": {
                    "label": "Install dependencies"
                },
                "conditions": [
                    {
                        "exec": "CaptainHook\\App\\Hook\\Condition\\FileChanged\\Any",
                        "args": [["composer.json", "composer.lock"]]
                    }
                ]
            }
        ]
    },
    "config": {
        "fail-on-first-error": true,
        "verbosity": "normal",
        "ansi-colors": true,
        "run-mode": "local",
        "git-directory": ".git"
    }
}
